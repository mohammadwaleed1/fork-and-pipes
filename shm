//producer
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <sys/mman.h>
#include <unistd.h>

int main() {
    int fd;
    char *ptr;

    // Step 1 - create shared memory
    fd = shm_open("/myshm", O_CREAT | O_RDWR, 0666);

    // Step 2 - set size
    ftruncate(fd, 4096);

    // Step 3 - map it
    ptr = mmap(0, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);

    // Step 4 - write message
    sprintf(ptr, "Hello World from Producer!");
    printf("Producer wrote: %s\n", ptr);

    // keep alive so consumer can read
    sleep(5);

    return 0;
}
//////consumer
#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <sys/mman.h>

int main() {
    int fd;
    char *ptr;

    // Step 1 - open existing shared memory
    fd = shm_open("/myshm", O_RDONLY, 0666);

    // Step 2 - map it
    ptr = mmap(0, 4096, PROT_READ, MAP_SHARED, fd, 0);

    // Step 3 - read message
    printf("Consumer read: %s\n", ptr);

    // Step 4 - cleanup
    shm_unlink("/myshm");

    return 0;
}
