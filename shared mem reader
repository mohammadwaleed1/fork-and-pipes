#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/mman.h>
#include <unistd.h>
#include <fcntl.h>

int main() {
    const int SIZE    = 4096;
    const char *name  = "OS";    // ← same name as writer

    int fd;
    char *ptr;

    // STEP 1 — open existing shared memory (no O_CREAT — already exists)
    fd = shm_open(name, O_RDONLY, 0666);

    // STEP 2 — map into memory
    ptr = (char*)mmap(0, SIZE, PROT_READ, MAP_SHARED, fd, 0);

    // STEP 3 — read from shared memory
    printf("Read from shared memory: %s\n", ptr);

    // STEP 4 — cleanup
    shm_unlink(name);   // ← delete shared memory object

    return 0;
}
