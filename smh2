////cons
#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <sys/shm.h>
#include <sys/stat.h>
#include <sys/mman.h>
 
int main() {
    const int SIZE = 4096;
    const char *name = "OS";
    int fd;
    char *ptr;
 
    // Open existing shared memory object
    fd = shm_open(name, O_RDONLY, 0666);
 
    // Map it
    ptr = (char *)mmap(0, SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
    sleep(5);
    // Read from shared memory
    printf("%s\n", (char *)ptr);
 
    // Remove shared memory object
    shm_unlink(name);
    return 0;
}
///////prod
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <sys/shm.h>
#include <sys/stat.h>
#include <sys/mman.h>
#include <unistd.h>
 
int main() {
    const int SIZE = 4096;         // size of shared memory
    const char *name = "OS";       // name of shared memory object
    const char *msg0 = "Hello";
    const char *msg1 = "World!";
 
    int fd;
    char *ptr;
 
    // Create shared memory object
    fd = shm_open(name, O_CREAT | O_RDWR, 0666);
 
    // Set the size
    ftruncate(fd, SIZE);
 
    // Map into process address space
    ptr = (char *)mmap(0, SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
 
    // Write to shared memory
    sprintf(ptr, "%s", msg0);
    ptr += strlen(msg0);
    sprintf(ptr, "%s", msg1);
    ptr += strlen(msg1);
    sleep(5);
    return 0;
}
